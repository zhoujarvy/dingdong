{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DingDong",
  "version": "1.3.0",
  "identifier": "com.dingdong.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "叮咚",
        "width": 440,
        "height": 620,
        "minWidth": 400,
        "minHeight": 540,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["icons/badges/*"],
    "windows": {
      "wix": { "language": ["zh-CN"] },
      "nsis": { "languages": ["SimpChinese"], "displayLanguageSelector": false }
    }
  }
}
