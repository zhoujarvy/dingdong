<Window x:Class="DingDong.NotifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="叮咚消息" Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" Cursor="Hand">
    <Border x:Name="Card" Background="White" CornerRadius="10" Margin="6"
            BorderBrush="#E0E6ED" BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown"
            MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
        <Border.BitmapEffect>
            <DropShadowBitmapEffect Color="#000000" ShadowDepth="2" Softness="0.4" Opacity="0.35"/>
        </Border.BitmapEffect>
        <Grid Margin="14,10,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="🔔" FontSize="18" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBlock x:Name="TbTitle" Grid.Row="0" Grid.Column="1" FontSize="14" FontWeight="Bold"
                       Foreground="#303133" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Button x:Name="BtnClose" Grid.Row="0" Grid.Column="2" Content="✕" FontSize="11"
                    BorderThickness="0" Background="Transparent" Foreground="#909399"
                    Cursor="Hand" VerticalAlignment="Top" Click="BtnClose_Click"/>

            <TextBlock x:Name="TbMeta" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                       FontSize="11" Foreground="#909399" Margin="0,4,0,0"/>

            <TextBlock x:Name="TbContent" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                       FontSize="12" Foreground="#606266" Margin="0,6,0,0"
                       TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
