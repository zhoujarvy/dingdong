<Window x:Class="DingDong.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="叮咚" Height="560" Width="480"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#F5F7FA">
    <Window.Resources>
        <!-- 线性矢量图标（Stroke 描边，Win7 兼容，无需字体/图片资源） -->
        <Geometry x:Key="IconBell">M12 2.5C8.4 2.5 5.5 5.4 5.5 9v3.3c0 .7-.3 1.4-.8 1.9L3.5 15.7h17l-1.2-1.5c-.5-.5-.8-1.2-.8-1.9V9c0-3.6-2.9-6.5-6.5-6.5z M9.8 17.7a2.2 2.2 0 0 0 4.4 0</Geometry>
        <Geometry x:Key="IconCopy">M9.5 9.5h9v9h-9z M5.5 14.5v-9h9</Geometry>
        <Geometry x:Key="IconLogout">M13.5 15.5l3.5-3.5-3.5-3.5 M17 12H8.5 M14.5 4.5h-8a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h8</Geometry>
        <Geometry x:Key="IconTrash">M4 6.5h16 M9 6.5V5a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 15 5v1.5 M6.5 6.5l.8 12a2 2 0 0 0 2 1.9h5.4a2 2 0 0 0 2-1.9l.8-12 M10 10.5v6 M14 10.5v6</Geometry>
        <Style x:Key="Icon14" TargetType="Path">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Icon14White" TargetType="Path" BasedOn="{StaticResource Icon14}">
            <Setter Property="Stroke" Value="White"/>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#606266"/>
            <Setter Property="BorderBrush" Value="#DCDFE6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <!-- ===== 注册 / 登录面板 ===== -->
        <Grid x:Name="RegisterPanel" VerticalAlignment="Center">
            <StackPanel MaxWidth="340">
                <TextBlock Text="🔔" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="叮 咚" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                           Margin="0,4,0,2" Foreground="#303133"/>
                <TextBlock Text="消息推送客户端" FontSize="13" Foreground="#909399"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>
                <TextBlock Text="服务器地址" FontSize="13" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtServerHost" Grid.Column="0" Height="32" FontSize="13"
                             VerticalContentAlignment="Center" Text="127.0.0.1"/>
                    <TextBox x:Name="TxtServerPort" Grid.Column="2" Height="32" FontSize="13"
                             VerticalContentAlignment="Center" Text="8000"/>
                </Grid>
                <!-- 注册模式：终端名称 -->
                <TextBlock x:Name="TbNameLabel" Text="终端名称" FontSize="13" Margin="0,14,0,4"/>
                <TextBox x:Name="TxtTerminalName" Height="32" FontSize="13"
                         VerticalContentAlignment="Center"
                         KeyDown="TxtTerminalName_KeyDown"/>
                <!-- 登录模式：终端编码 + 名称 -->
                <TextBlock x:Name="TbCodeLabel" Text="终端编码（6 位）" FontSize="13"
                           Margin="0,14,0,4" Visibility="Collapsed"/>
                <TextBox x:Name="TxtLoginCode" Height="32" FontSize="13" MaxLength="6"
                         VerticalContentAlignment="Center" Visibility="Collapsed"
                         KeyDown="TxtLoginCode_KeyDown"/>
                <TextBlock x:Name="TbLoginNameLabel" Text="终端名称（需与注册时一致）" FontSize="13"
                           Margin="0,14,0,4" Visibility="Collapsed"/>
                <TextBox x:Name="TxtLoginName" Height="32" FontSize="13" MaxLength="50"
                         VerticalContentAlignment="Center" Visibility="Collapsed"
                         KeyDown="TxtLoginCode_KeyDown"/>
                <Button x:Name="BtnRegister" Content="注册终端" Height="36" Margin="0,20,0,0"
                        FontSize="14" Click="BtnRegister_Click"/>
                <Button x:Name="BtnLogin" Content="登录" Height="36" Margin="0,20,0,0"
                        FontSize="14" Visibility="Collapsed" Click="BtnLogin_Click"/>
                <TextBlock x:Name="TbModeSwitch" Text="已有终端编码？点此登录" FontSize="12"
                           Foreground="#409EFF" Cursor="Hand" HorizontalAlignment="Center"
                           Margin="0,14,0,0" MouseLeftButtonDown="TbModeSwitch_Click"/>
                <TextBlock x:Name="TbRegisterTip" TextWrapping="Wrap" FontSize="12"
                           Foreground="#909399" Margin="0,12,0,0" HorizontalAlignment="Center"
                           Text="注册后将获得一个 6 位终端编码，请妥善保存"/>
            </StackPanel>
        </Grid>

        <!-- ===== 主面板（状态 + 设置，消息统一在网页消息中心查看） ===== -->
        <Grid x:Name="MainPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 终端状态卡 -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Border x:Name="StatusPill" Background="#F4F4F5" CornerRadius="9"
                                Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#909399"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbStatus" Text="未连接" FontSize="12" Foreground="#909399"
                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TbUnread" FontSize="12" Foreground="#409EFF"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TbCode" FontSize="26" FontWeight="Bold"
                                       Foreground="#409EFF"/>
                            <TextBlock x:Name="TbTerminalName" FontSize="15" FontWeight="Medium"
                                       Foreground="#606266" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource GhostBtn}" ToolTip="复制终端编码"
                                Click="BtnCopyCode_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon14}" Data="{StaticResource IconCopy}"/>
                                <TextBlock Text="复制编码" FontSize="12" Margin="5,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnOpenInbox" Height="34" Padding="14,0" FontSize="13"
                                Background="#409EFF" Foreground="White" BorderBrush="#409EFF"
                                Cursor="Hand" Click="BtnOpenInbox_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon14White}" Data="{StaticResource IconBell}"/>
                                <TextBlock Text="消息中心" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Height="34" Margin="10,0,0,0" Padding="12,0" FontSize="13"
                                Foreground="#E6A23C" BorderBrush="#E6A23C" Cursor="Hand"
                                ToolTip="退出登录：仅断开本机，编码与名称保留，可在此电脑或新电脑重新登录"
                                Click="BtnLogout_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon14}" Data="{StaticResource IconLogout}"/>
                                <TextBlock Text="退出登录" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Height="34" Margin="10,0,0,0" Padding="12,0" FontSize="13"
                                Foreground="#F56C6C" BorderBrush="#F56C6C" Cursor="Hand"
                                ToolTip="注销终端：编号作废，无法再登录，只能重新注册"
                                Click="BtnUnregister_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon14}" Data="{StaticResource IconTrash}"/>
                                <TextBlock Text="注销终端" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="消息的查看、已读与删除均在网页消息中心进行，弹窗点击也会打开消息中心。"
                               FontSize="11" Foreground="#C0C4CC" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 设置卡 -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="连接" FontSize="14" FontWeight="Bold" Foreground="#303133"/>
                        <TextBlock Text="服务器地址与端口（保存后自动重连）" FontSize="12" Foreground="#606266" Margin="0,10,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSettingsHost" Grid.Column="0" Height="30" FontSize="13"
                                     VerticalContentAlignment="Center"/>
                            <TextBox x:Name="TxtSettingsPort" Grid.Column="2" Height="30" FontSize="13"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="退出登录 / 注销终端按钮在上方终端信息卡中。"
                                   FontSize="11" Foreground="#C0C4CC" Margin="0,8,0,0"/>

                        <TextBlock Text="提醒方式" FontSize="14" FontWeight="Bold" Foreground="#303133"
                                   Margin="0,20,0,0"/>
                        <CheckBox x:Name="ChkSound" Content="播放提示音" Margin="0,10,0,0"
                                  FontSize="13"/>
                        <CheckBox x:Name="ChkTts" Content="语音朗读消息简介（Windows 系统语音）"
                                  Margin="0,10,0,0" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Margin="24,8,0,0">
                            <TextBlock Text="朗读内容：" FontSize="12" Foreground="#606266"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbTtsMode" FontSize="12" Width="170">
                                <ComboBoxItem Content="仅标题" Tag="title"/>
                                <ComboBoxItem Content="标题 + 内容摘要" Tag="both"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="弹窗自动关闭：" FontSize="13" Foreground="#606266"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbNotifyClose" FontSize="12" Width="150" Margin="6,0,0,0">
                                <ComboBoxItem Content="10 秒" Tag="10"/>
                                <ComboBoxItem Content="30 秒" Tag="30"/>
                                <ComboBoxItem Content="60 秒（默认）" Tag="60" IsSelected="True"/>
                                <ComboBoxItem Content="3 分钟" Tag="180"/>
                                <ComboBoxItem Content="不自动关闭，点击后关闭" Tag="0"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="其他" FontSize="14" FontWeight="Bold" Foreground="#303133"
                                   Margin="0,20,0,0"/>
                        <CheckBox x:Name="ChkAutoStart" Content="开机自动启动（最小化到托盘）"
                                  Margin="0,10,0,0" FontSize="13"/>
                        <Button x:Name="BtnSaveSettings" Content="保存设置" Width="120" Height="34"
                                Margin="0,24,0,0" FontSize="13" Click="BtnSaveSettings_Click"/>

                        <TextBlock Text="关闭窗口将最小化到系统托盘，如需退出请在托盘图标右键菜单中选择退出。"
                                   FontSize="11" Foreground="#C0C4CC" Margin="0,20,0,10" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
