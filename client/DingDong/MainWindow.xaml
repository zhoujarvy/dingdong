<Window x:Class="DingDong.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="叮咚" Height="560" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#F5F7FA">
    <Grid Margin="16">
        <!-- ===== 注册面板 ===== -->
        <Grid x:Name="RegisterPanel" VerticalAlignment="Center">
            <StackPanel MaxWidth="340">
                <TextBlock Text="🔔" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="叮 咚" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                           Margin="0,4,0,2" Foreground="#303133"/>
                <TextBlock Text="消息推送客户端" FontSize="13" Foreground="#909399"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>
                <TextBlock Text="服务器地址" FontSize="13" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtServerUrl" Height="32" FontSize="13"
                         VerticalContentAlignment="Center" Text="http://"/>
                <TextBlock Text="终端名称" FontSize="13" Margin="0,14,0,4"/>
                <TextBox x:Name="TxtTerminalName" Height="32" FontSize="13"
                         VerticalContentAlignment="Center"
                         KeyDown="TxtTerminalName_KeyDown"/>
                <Button x:Name="BtnRegister" Content="注册终端" Height="36" Margin="0,20,0,0"
                        FontSize="14" Click="BtnRegister_Click"/>
                <TextBlock x:Name="TbRegisterTip" TextWrapping="Wrap" FontSize="12"
                           Foreground="#909399" Margin="0,12,0,0" HorizontalAlignment="Center"
                           Text="注册后将获得一个 6 位终端编码，请妥善保存"/>
            </StackPanel>
        </Grid>

        <!-- ===== 主面板（状态 + 设置，消息统一在网页消息中心查看） ===== -->
        <Grid x:Name="MainPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 终端状态卡 -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#909399"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="TbStatus" Text="未连接" FontSize="12" Foreground="#909399"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TbUnread" FontSize="12" Foreground="#409EFF"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock x:Name="TbCode" FontSize="26" FontWeight="Bold"
                                   Foreground="#409EFF"/>
                        <TextBlock x:Name="TbTerminalName" FontSize="13" Foreground="#909399"
                                   Margin="12,0,0,0" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnOpenInbox" Content="打开消息中心" Height="34" Width="130"
                                FontSize="13" Click="BtnOpenInbox_Click"/>
                        <Button Content="复制编码" Height="34" Margin="10,0,0,0" Padding="14,0"
                                FontSize="13" Click="BtnCopyCode_Click"/>
                    </StackPanel>
                    <TextBlock Text="消息的查看、已读与删除均在网页消息中心进行，弹窗点击也会打开消息中心。"
                               FontSize="11" Foreground="#C0C4CC" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 设置卡 -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="连接" FontSize="14" FontWeight="Bold" Foreground="#303133"/>
                        <TextBlock Text="服务器地址" FontSize="12" Foreground="#606266" Margin="0,10,0,4"/>
                        <TextBox x:Name="TxtSettingsServer" Height="30" FontSize="13"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="注销此终端，重新注册" HorizontalAlignment="Right"
                                FontSize="11" Padding="10,3" Margin="0,10,0,0"
                                Foreground="#F56C6C" BorderBrush="#F56C6C"
                                Click="BtnUnregister_Click"/>

                        <TextBlock Text="提醒方式" FontSize="14" FontWeight="Bold" Foreground="#303133"
                                   Margin="0,20,0,0"/>
                        <CheckBox x:Name="ChkSound" Content="播放提示音" Margin="0,10,0,0"
                                  FontSize="13"/>
                        <CheckBox x:Name="ChkTts" Content="语音朗读消息简介（Windows 系统语音）"
                                  Margin="0,10,0,0" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Margin="24,8,0,0">
                            <TextBlock Text="朗读内容：" FontSize="12" Foreground="#606266"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbTtsMode" FontSize="12" Width="170">
                                <ComboBoxItem Content="仅标题" Tag="title"/>
                                <ComboBoxItem Content="标题 + 内容摘要" Tag="both"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="其他" FontSize="14" FontWeight="Bold" Foreground="#303133"
                                   Margin="0,20,0,0"/>
                        <CheckBox x:Name="ChkAutoStart" Content="开机自动启动（最小化到托盘）"
                                  Margin="0,10,0,0" FontSize="13"/>
                        <Button x:Name="BtnSaveSettings" Content="保存设置" Width="120" Height="34"
                                Margin="0,24,0,0" FontSize="13" Click="BtnSaveSettings_Click"/>

                        <TextBlock Text="关闭窗口将最小化到系统托盘，如需退出请在托盘图标右键菜单中选择退出。"
                                   FontSize="11" Foreground="#C0C4CC" Margin="0,20,0,10" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
